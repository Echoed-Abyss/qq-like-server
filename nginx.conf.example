server {
    listen 80;
    server_name your-domain.com;

    # HTTP API 反向代理
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # 缓冲区设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # 如果需要 Web 前端，可配置静态文件
    # location / {
    #     root /www/wwwroot/qq-like-web;
    #     index index.html;
    #     try_files $uri $uri/ /index.html;
    # }

    # 访问日志
    access_log /www/wwwlogs/qq-like-server-access.log;
    error_log /www/wwwlogs/qq-like-server-error.log;
}

# TCP 长连接配置（注意：TCP 不能通过 HTTP 反向代理，需要直接开放端口或使用 stream 模块）
# 如果需要通过 Nginx 代理 TCP，需要在 nginx.conf 的 http 块外配置 stream：
#
# stream {
#     server {
#         listen 9090;
#         proxy_pass 127.0.0.1:9090;
#     }
# }
