# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release

# TCP 配置
TCP_HOST=0.0.0.0
TCP_PORT=9090

# 数据库配置 (当前使用 SQLite)
DB_TYPE=sqlite
DB_PATH=./data/qq_like.db

# Token 配置
TOKEN_SECRET=your-secret-key-change-this-to-something-random-and-long
TOKEN_EXPIRE_HOUR=168

# 应用密钥（签名验证用）
APP_SECRET=your-app-secret-change-this-to-something-random
